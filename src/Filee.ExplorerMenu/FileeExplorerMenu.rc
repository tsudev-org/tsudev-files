// Version information of the Explorer context-menu DLL. build/build-explorer-menu.ps1 passes the app version as
// TSUFILES_VERSION_MAJOR/MINOR/PATCH and TSUFILES_VERSION_TEXT.

#include <winver.h>

#ifndef TSUFILES_VERSION_MAJOR
#define TSUFILES_VERSION_MAJOR 0
#define TSUFILES_VERSION_MINOR 0
#define TSUFILES_VERSION_PATCH 0
#define TSUFILES_VERSION_TEXT "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION TSUFILES_VERSION_MAJOR, TSUFILES_VERSION_MINOR, TSUFILES_VERSION_PATCH, 0
PRODUCTVERSION TSUFILES_VERSION_MAJOR, TSUFILES_VERSION_MINOR, TSUFILES_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Filee contributors"
            VALUE "FileDescription", "Filee File Explorer context menu"
            VALUE "FileVersion", TSUFILES_VERSION_TEXT
            VALUE "InternalName", "FileeExplorerMenu"
            VALUE "LegalCopyright", "Copyright (c) Filee contributors. MIT License."
            VALUE "OriginalFilename", "FileeExplorerMenu.dll"
            VALUE "ProductName", "Filee"
            VALUE "ProductVersion", TSUFILES_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
