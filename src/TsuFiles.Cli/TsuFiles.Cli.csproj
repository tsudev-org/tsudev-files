<!--
  TsuFiles.Cli: the "filee" command line. Converts files and watches folders without the tray app, with the same
  engines, presets and settings. Published next to Filee.exe as tsufiles-cli.exe (one runtime for both); the installer
  puts a "tsufiles" shim on PATH (cli\tsufiles.cmd).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tsufiles-cli</AssemblyName>
    <RootNamespace>TsuFiles.Cli</RootNamespace>
    <ApplicationIcon>..\TsuFiles.App\Assets\Icons\filee.ico</ApplicationIcon>
    <!-- The Recycle Bin is IFileOperation, a COM interface (TsuFiles.Platform.Windows). -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TsuFiles.Core\TsuFiles.Core.csproj" />
    <ProjectReference Include="..\TsuFiles.Engines\TsuFiles.Engines.csproj" />
    <!-- "Replace the original" moves originals to the Recycle Bin / Trash (MoveToTrash), as the app does. -->
    <ProjectReference Include="..\TsuFiles.Platform.Windows\TsuFiles.Platform.Windows.csproj" />
    <ProjectReference Include="..\TsuFiles.Platform.Linux\TsuFiles.Platform.Linux.csproj" />
    <ProjectReference Include="..\TsuFiles.Platform.MacOS\TsuFiles.Platform.MacOS.csproj" />
  </ItemGroup>

  <!-- Error messages and built-in preset names, in English (the app's translation file). -->
  <ItemGroup>
    <EmbeddedResource Include="..\TsuFiles.App\Assets\i18n\en.json" LogicalName="TsuFiles.Cli.en.json" />
    <EmbeddedResource Include="..\TsuFiles.App\Assets\i18n\vi.json" LogicalName="TsuFiles.Cli.vi.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TsuFiles.Cli.Tests" />
  </ItemGroup>
</Project>
