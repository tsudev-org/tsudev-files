<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TsuFiles.Setup.App"
             Name="Filee Setup"
             RequestedThemeVariant="Default">
  <!-- Light or dark follows Windows (RequestedThemeVariant="Default"), like Filee's "System" theme. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://TsuFiles.Setup/Views/StateViews.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://TsuFiles.Setup/Styles/Soft.axaml" />
    <StyleInclude Source="avares://TsuFiles.Setup/Styles/Setup.axaml" />
  </Application.Styles>
</Application>
