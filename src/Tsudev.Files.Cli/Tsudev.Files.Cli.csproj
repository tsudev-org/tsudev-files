<!--
  Tsudev.Files.Cli: the "filee" command line. Converts files and watches folders without the tray app, with the same
  engines, presets and settings. Published next to Filee.exe as filee-cli.exe (one runtime for both); the installer
  puts a "filee" shim on PATH (cli\filee.cmd).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>filee-cli</AssemblyName>
    <RootNamespace>Tsudev.Files.Cli</RootNamespace>
    <ApplicationIcon>..\Tsudev.Files.App\Assets\Icons\filee.ico</ApplicationIcon>
    <!-- The Recycle Bin is IFileOperation, a COM interface (Tsudev.Files.Platform.Windows). -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tsudev.Files.Core\Tsudev.Files.Core.csproj" />
    <ProjectReference Include="..\Tsudev.Files.Engines\Tsudev.Files.Engines.csproj" />
    <!-- "Replace the original" moves originals to the Recycle Bin / Trash (MoveToTrash), as the app does. -->
    <ProjectReference Include="..\Tsudev.Files.Platform.Windows\Tsudev.Files.Platform.Windows.csproj" />
    <ProjectReference Include="..\Tsudev.Files.Platform.Linux\Tsudev.Files.Platform.Linux.csproj" />
    <ProjectReference Include="..\Tsudev.Files.Platform.MacOS\Tsudev.Files.Platform.MacOS.csproj" />
  </ItemGroup>

  <!-- Error messages and built-in preset names, in English (the app's translation file). -->
  <ItemGroup>
    <EmbeddedResource Include="..\Tsudev.Files.App\Assets\i18n\en.json" LogicalName="Tsudev.Files.Cli.en.json" />
    <EmbeddedResource Include="..\Tsudev.Files.App\Assets\i18n\vi.json" LogicalName="Tsudev.Files.Cli.vi.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tsudev.Files.Cli.Tests" />
  </ItemGroup>
</Project>
