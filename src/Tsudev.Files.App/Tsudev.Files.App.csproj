<!--
  Tsudev.Files.App: the Avalonia desktop application (tray, donut toolbar, settings window).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Filee</AssemblyName>
    <RootNamespace>Tsudev.Files.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\filee.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tsudev.Files.Core\Tsudev.Files.Core.csproj" />
    <ProjectReference Include="..\Tsudev.Files.Engines\Tsudev.Files.Engines.csproj" />
    <ProjectReference Include="..\Tsudev.Files.Platform.Windows\Tsudev.Files.Platform.Windows.csproj" />
    <ProjectReference Include="..\Tsudev.Files.Platform.Linux\Tsudev.Files.Platform.Linux.csproj" />
    <ProjectReference Include="..\Tsudev.Files.Platform.MacOS\Tsudev.Files.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="SharpHook" />
  </ItemGroup>

  <PropertyGroup>
    <TsudevFilesNativeWayland Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">true</TsudevFilesNativeWayland>
    <DefineConstants Condition="'$(TsudevFilesNativeWayland)' == 'true'">$(DefineConstants);FILEE_NATIVE_WAYLAND</DefineConstants>
  </PropertyGroup>

  <!-- Linux-only Wayland packages to keep Windows and macOS binaries small -->
  <ItemGroup Condition="'$(TsudevFilesNativeWayland)' == 'true'">
    <PackageReference Include="Avalonia.Wayland" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Shown on the About page. -->
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.md" Link="Assets\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tsudev.Files.App.Tests" />
  </ItemGroup>

  <!-- Native debug symbols from NuGet packages (SkiaSharp, HarfBuzz: ~100 MB) are useless to users. -->
  <Target Name="TsudevFilesRemoveNativeSymbols" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_FileeNativePdb Include="$(PublishDir)lib*.pdb" />
    </ItemGroup>
    <Delete Files="@(_FileeNativePdb)" />
  </Target>

  <!-- Repository URL for the updater / About page, taken from Directory.Build.props. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryUrl</_Parameter1>
      <_Parameter2>$(TsudevFilesRepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
    <!-- Published builds (installer, portable zip) set -p:TsudevFilesRelease=true: only they register Explorer and startup
         entries (UpdateService.IsReleaseBuild), so running from source leaves the user's system alone. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(TsudevFilesRelease)' == 'true'">
      <_Parameter1>TsudevFilesRelease</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- How official builds check updates (Directory.Build.props): the update key and the expected publisher. Running
       from source and the tests keep to today's checks. -->
  <ItemGroup Condition="'$(TsudevFilesRelease)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(TsudevFilesUpdatePublicKey)' != ''">
      <_Parameter1>TsudevFilesUpdatePublicKey</_Parameter1>
      <_Parameter2>$(TsudevFilesUpdatePublicKey)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(TsudevFilesExpectedPublisher)' != ''">
      <_Parameter1>TsudevFilesExpectedPublisher</_Parameter1>
      <_Parameter2>$(TsudevFilesExpectedPublisher)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(TsudevFilesExpectedIssuer)' != ''">
      <_Parameter1>TsudevFilesExpectedIssuer</_Parameter1>
      <_Parameter2>$(TsudevFilesExpectedIssuer)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(TsudevFilesExpectedSignerKeys)' != ''">
      <_Parameter1>TsudevFilesExpectedSignerKeys</_Parameter1>
      <_Parameter2>$(TsudevFilesExpectedSignerKeys)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- A subject alone is only text: an expected publisher needs the certificate authority that issued it. -->
  <Target Name="TsudevFilesCheckExpectedPublisher" BeforeTargets="CoreCompile"
          Condition="'$(TsudevFilesRelease)' == 'true' And '$(TsudevFilesExpectedPublisher)' != '' And '$(TsudevFilesExpectedIssuer)' == ''">
    <Error Text="TsudevFilesExpectedPublisher is set without TsudevFilesExpectedIssuer (Directory.Build.props)." />
  </Target>
</Project>
