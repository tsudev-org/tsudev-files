<!--
  TsuFiles.Engines: IConverter implementations (one file per engine) and helpers to find external tools.
  Register new engines in EngineRegistry.cs.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TsuFiles.Engines</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TsuFiles.Core\TsuFiles.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="DiscUtils.Iso9660" />
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="Unhwp" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="ExcelNumberFormat" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="MimeKitLite" />
    <PackageReference Include="ACadSharp" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="MsgReader" />
    <PackageReference Include="SharpGLTF.Core" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    Unhwp's package has no native library for linux-arm64 and win-arm64. build/build-native.py builds it from the
    package's source; the build passes it in (dotnet build/publish -p:UnhwpNativeLibrary=<path to libunhwp.so or
    unhwp.dll>) and it lands next to the app, where Unhwp looks for it. Unset everywhere else.
  -->
  <ItemGroup Condition="'$(UnhwpNativeLibrary)' != ''">
    <None Include="$(UnhwpNativeLibrary)" Link="$([System.IO.Path]::GetFileName('$(UnhwpNativeLibrary)'))"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TsuFiles" />
    <InternalsVisibleTo Include="TsuFiles.Engines.Tests" />
    <InternalsVisibleTo Include="TsuFiles.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference HWPX (styles, page setup) from pypandoc-hwpx (MIT), see Hwp/Hwpx/HwpxWriter.cs. -->
    <EmbeddedResource Include="Hwp\Hwpx\blank.hwpx" LogicalName="TsuFiles.Engines.Hwpx.blank.hwpx" />
    <!-- Pinned downloads of optional engines, also read by build/fetch-engines.ps1. -->
    <EmbeddedResource Include="Infrastructure\engines.json" LogicalName="TsuFiles.Engines.engines.json" />
    <!-- Pinned Tesseract language data, downloaded when an OCR preset needs it (Ocr/OcrLanguages.cs). -->
    <EmbeddedResource Include="Infrastructure\ocr-languages.json" LogicalName="TsuFiles.Engines.ocr-languages.json" />
    <EmbeddedResource Include="Infrastructure\upscale-models.json" LogicalName="TsuFiles.Engines.upscale-models.json" />
  </ItemGroup>
</Project>
